# ==============================================================================
# منصة التعليم الإلكتروني — Environment Variables & Cloud Database Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL for Production Cloud Persistence)
# ------------------------------------------------------------------------------
# NOTE for Vercel Deployment:
# Serverless environments on Vercel are read-only for local files.
# Connecting a PostgreSQL database ensures persistent writes for quizzes,
# assignments, access codes, and student exam grades.

# Option A: Supabase (Recommended for Production & High Traffic)
# 1. Create a project at https://supabase.com
# 2. Go to: Project Settings -> Database -> Connection string
# 3. Use 'Transaction' mode (Port 6543) for DATABASE_URL, and 'Direct' (Port 5432) for DIRECT_URL:
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Option B: Neon.tech (Instant Serverless PostgreSQL)
# DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Option C: Vercel Postgres (via Vercel Dashboard -> Storage -> Postgres)
# DATABASE_URL="postgres://default:YOUR_PASSWORD@ep-sample-pooler.postgres.vercel-storage.com:5432/verceldb?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgres://default:YOUR_PASSWORD@ep-sample.postgres.vercel-storage.com:5432/verceldb?sslmode=require"

# Option D: Local SQLite (For offline development on your machine only)
# DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 2. NextAuth Authentication & Session Secret
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET="edu-platform-ultra-secure-jwt-secret-key-2026"
NEXTAUTH_URL="https://edu-platform-phi-pearl.vercel.app"

# ------------------------------------------------------------------------------
# 3. Optional WhatsApp / Notification Service
# ------------------------------------------------------------------------------
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
