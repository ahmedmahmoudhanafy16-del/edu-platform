// Prisma Schema for EduPlatform
// SQLite for Local Development & Vercel Preview (dev.db)

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. Core Users & RBAC
// -------------------------------------------------------------
model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  studentCode   String?  @unique // e.g. STU-001
  password      String?
  passwordHash  String   @default("")
  name          String
  role          String   @default("STUDENT") // STUDENT | TEACHER | PARENT | ADMIN
  phone         String?
  parentPhone   String?
  governorate   String?  @default("Cairo")
  grade         String?  @default("الصف الثالث الإعدادي")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relationships
  teacherClassrooms Classroom[]     @relation("TeacherClassrooms")
  enrollments       Enrollment[]
  quizResults       QuizResult[]
  submissions       AssignmentSubmission[]
  attendance        LiveAttendance[]
  sentMessages      ChatMessage[]
  notifications     ParentNotification[]
  redeemedCodes     SessionAccessCode[] @relation("UsedByRelation")
  studentCodes      SessionAccessCode[] @relation("UsedByStudentRelation")
}

// -------------------------------------------------------------
// 2. Classrooms & Academic Structure
// -------------------------------------------------------------
model Classroom {
  id          String   @id @default(cuid())
  name        String   // e.g. "الصف الثالث الإعدادي - رياضيات"
  code        String?  // e.g. "MATH-101"
  grade       String   @default("PREP_3")
  subject     String   @default("Math")
  teacherId   String
  createdAt   DateTime @default(now())

  teacher      User             @relation("TeacherClassrooms", fields: [teacherId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
  assignments  Assignment[]
  quizzes      Quiz[]
  resources    ClassResource[]
  liveSessions LiveSession[]
}

model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  classroomId String
  enrolledAt  DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([userId, classroomId])
}

// -------------------------------------------------------------
// 3. Assignments & Homework
// -------------------------------------------------------------
model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   @default("HOMEWORK")
  dueDate     DateTime
  maxScore    Float    @default(10)
  classroomId String
  createdAt   DateTime @default(now())

  classroom   Classroom              @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  fileUrl      String?
  textAnswer   String?
  grade        Float?
  teacherNote  String?
  status       String    @default("SUBMITTED") // SUBMITTED | GRADED
  submittedAt  DateTime  @default(now())
  gradedAt     DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

// -------------------------------------------------------------
// 4. Quizzes & Examination Engine (with Passcode Protection & Grade)
// -------------------------------------------------------------
model Quiz {
  id               String       @id @default(cuid())
  title            String
  type             String       @default("WEEKLY") // WEEKLY | MONTHLY
  duration         Int          @default(20) // in minutes
  passingScore     Int          @default(60) // percentage
  maxViolations    Int          @default(2)
  shuffleQuestions Boolean      @default(true)
  isPublished      Boolean      @default(true)
  accessCode       String?      @default("QUIZ-MATH-2026") // Passcode to unlock the quiz
  isCodeRequired   Boolean      @default(false)
  grade            String?      @default("الصف الثالث الإعدادي")
  classroomId      String?
  createdAt        DateTime     @default(now())

  classroom        Classroom?   @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  questions        Question[]
  results          QuizResult[]
}

model Question {
  id            String   @id @default(cuid())
  quizId        String
  text          String
  type          String   @default("MCQ") // MCQ | ESSAY
  options       String   @default("[]") // JSON stringified array of options
  correctAnswer String?
  maxScore      Int      @default(5)
  difficulty    String   @default("MEDIUM") // EASY | MEDIUM | HARD
  order         Int      @default(0)

  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizResult {
  id             String    @id @default(cuid())
  quizId         String
  studentId      String
  totalScore     Float?
  maxScore       Float     @default(0)
  autoScore      Float     @default(0)
  isPassed       Boolean   @default(false)
  status         String    @default("AUTO_GRADED") // PENDING | AUTO_GRADED | GRADED
  violationCount Int       @default(0)
  autoSubmitted  Boolean   @default(false)
  startedAt      DateTime  @default(now())
  submittedAt    DateTime  @default(now())

  quiz       Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student    User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  violations QuizViolation[]
}

model QuizViolation {
  id           String   @id @default(cuid())
  quizResultId String
  reason       String   // TAB_SWITCH | FULLSCREEN_EXIT | RIGHT_CLICK | DEV_TOOLS
  occurredAt   DateTime @default(now())

  quizResult QuizResult @relation(fields: [quizResultId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// 5. Educational Resources & PDFs
// -------------------------------------------------------------
model ClassResource {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   @default("PDF") // PDF | SUMMARY | HOMEWORK_SOLUTION
  fileUrl     String   @default("")
  url         String?
  classroomId String
  createdAt   DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// 6. Live Interactive Classroom & Access Codes
// -------------------------------------------------------------
model LiveSession {
  id          String   @id @default(cuid())
  title       String
  roomCode    String   @unique // e.g. LIVE-MATH1
  targetGrade String?
  classroomId String
  isActive    Boolean  @default(false)
  startedAt   DateTime?
  endedAt     DateTime?

  classroom   Classroom           @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  attendance  LiveAttendance[]
  messages    ChatMessage[]
  accessCodes SessionAccessCode[]
}

model SessionAccessCode {
  id              String       @id @default(cuid())
  code            String       @unique // e.g. EDU-A8B9-2026
  liveSessionId   String
  isUsed          Boolean      @default(false)
  usedById        String?
  usedByStudentId String?
  usedAt          DateTime?
  expiresAt       DateTime?
  price           Float        @default(50.0)
  createdAt       DateTime     @default(now())

  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  usedBy        User?       @relation("UsedByRelation", fields: [usedById], references: [id], onDelete: SetNull)
  usedByStudent User?       @relation("UsedByStudentRelation", fields: [usedByStudentId], references: [id], onDelete: SetNull)
}

model LiveAttendance {
  id            String   @id @default(cuid())
  liveSessionId String   @default("")
  sessionId     String?
  studentId     String
  joinedAt      DateTime @default(now())
  durationMin   Int      @default(0)

  liveSession LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  student     User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([liveSessionId, studentId])
}

model ChatMessage {
  id            String   @id @default(cuid())
  liveSessionId String
  senderId      String
  message       String
  createdAt     DateTime @default(now())

  liveSession LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  sender      User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// 7. Parent Notification & WhatsApp Tracking
// -------------------------------------------------------------
model ParentNotification {
  id          String   @id @default(cuid())
  parentId    String
  title       String
  body        String
  type        String   @default("WHATSAPP") // WHATSAPP | SMS | IN_APP
  status      String   @default("DELIVERED") // SENT | DELIVERED | FAILED
  metadata    String?  // JSON string
  sentAt      DateTime @default(now())

  parent User @relation(fields: [parentId], references: [id], onDelete: Cascade)
}

model NotificationLog {
  id           String   @id @default(cuid())
  type         String   @default("QUIZ_RESULT")
  recipient    String   @default("")
  studentId    String?
  content      String   @default("")
  status       String   @default("DELIVERED")
  errorMessage String?
  createdAt    DateTime @default(now())
}
